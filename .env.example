# --- Vultr Serverless Inference (required) ---
# Create a key: console.vultr.com -> Serverless -> Inference
VULTR_INFERENCE_API_KEY=
INFERENCE_BASE_URL=https://api.vultrinference.com/v1
AGENT_MODEL=deepseek-v4.1-flash-1017
# Optional multimodal model used to double-check generated charts ("" disables)
VISION_MODEL=nemotron-3-nano-omni-30b-a3b-reasoning

# --- Sandbox ---
SANDBOX_IMAGE=blastproof-sandbox:latest
# "runsc" = gVisor (user-space kernel). Leave empty for Docker's default runc.
SANDBOX_RUNTIME=
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
SANDBOX_PIDS=64
SANDBOX_TIMEOUT=30
MAX_CONCURRENT_SANDBOXES=4

# --- App ---
MAX_ATTEMPTS=3
MAX_UPLOAD_MB=20
RATE_LIMIT_JOBS=12
RATE_LIMIT_WINDOW_S=600
# Set to 1 only when running behind the bundled Caddy reverse proxy
TRUST_PROXY=0
DATA_DIR=./var
